{
  "rewrites": [
    {
      "source": "/consent/:token",
      "destination": "/consent.html"
    },
    {
      "source": "/api/c/:token",
      "destination": "https://x5s4btnwek.execute-api.us-east-1.amazonaws.com/c/:token"
    },
    {
      "source": "/api/c/:token/sign",
      "destination": "https://x5s4btnwek.execute-api.us-east-1.amazonaws.com/c/:token/sign"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/consent/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/consent.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(og-image.png|icon-512.png)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    }
  ]
}
